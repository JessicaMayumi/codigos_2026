@startuml diagrama-classes-buscador
title Buscador de Arquivos - Diagrama de Classes\nFURB - Algoritmos e Estruturas de Dados

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam classBackgroundColor #FAFAFA
skinparam classBorderColor #555555
skinparam packageStyle rectangle
skinparam linetype ortho

package "br.furb.buscador.estruturas" #EEF6FF {

    class "NoLista<T>" as NoLista {
        - info : T
        - proximo : NoLista<T>
        + getInfo() : T
        + setInfo(v : T)
        + getProximo() : NoLista<T>
        + setProximo(n : NoLista<T>)
    }

    class "ListaEncadeada<T>" as Lista {
        - primeiro : NoLista<T>
        - quantidade : int
        + inserir(v : T)
        + contem(v : T) : boolean
        + retirar(v : T) : boolean
        + estaVazia() : boolean
        + tamanho() : int
        + getPrimeiro() : NoLista<T>
    }

    class "NoMapa<T>" as NoMapa {
        - chave : String
        - valor : T
        + getChave() : String
        + getValor() : T
        + setValor(v : T)
        + equals(o : Object) : boolean
        + hashCode() : int
    }

    class "MapaDispersao<T>" as Mapa {
        - info : ListaEncadeada<NoMapa<T>>[]
        - quantidade : int
        + MapaDispersao(tamanho : int)
        + calcularHash(chave : String) : int
        + inserir(chave : String, v : T)
        + buscar(chave : String) : T
        + remover(chave : String) : boolean
        + calcularFatorCarga() : double
        + getQuantidade() : int
        + getCapacidade() : int
        + chaves() : ListaEncadeada<String>
        + entradas() : ListaEncadeada<NoMapa<T>>
    }

    Lista *-- "0..*" NoLista : primeiro/proximo
    Mapa *-- "0..*" Lista : info (array)
    Lista ..> NoMapa : armazena
}

package "br.furb.buscador.modelo" #F1FBEE {

    class Documento {
        - caminho : String
        + Documento(caminho : String)
        + getCaminho() : String
        + equals(o : Object) : boolean
        + hashCode() : int
        + toString() : String
    }

    class Indice {
        - {static} CAPACIDADE : int = 997
        - mapa : MapaDispersao<ListaEncadeada<Documento>>
        + adicionarOcorrencia(palavra : String, doc : Documento)
        + documentosCom(palavra : String) : ListaEncadeada<Documento>
        + totalPalavras() : int
        + getMapa() : MapaDispersao<ListaEncadeada<Documento>>
    }

    Indice *-- "1" Mapa : usa
    Mapa ..> Documento : valores
}

package "br.furb.buscador.servico" #FFF7E6 {

    class ExtratorPalavras <<utility>> {
        + {static} extrair(texto : String) : ListaEncadeada<String>
        - {static} adicionarSeValida(lista : ListaEncadeada<String>, token : String)
    }

    class Indexador {
        - arquivosIndexados : int
        - palavrasProcessadas : int
        + indexar(dir : File) : Indice
        + indexarEm(dir : File, indice : Indice) : Indice
        + getArquivosIndexados() : int
        + getPalavrasProcessadas() : int
        - percorrer(dir : File, indice : Indice)
        - indexarArquivo(arq : File, indice : Indice)
    }

    class Buscador {
        - indice : Indice
        + Buscador(indice : Indice)
        + buscar(termos : ListaEncadeada<String>) : ListaEncadeada<Documento>
        - copiar(origem : ListaEncadeada<Documento>) : ListaEncadeada<Documento>
        - intersecao(a : ListaEncadeada<Documento>, b : ListaEncadeada<Documento>) : ListaEncadeada<Documento>
    }

    class PersistenciaIndice {
        - {static} CABECALHO : String
        - {static} SEPARADOR : String
        + salvar(indice : Indice, arq : File)
        + carregar(arq : File) : Indice
    }

    Indexador ..> ExtratorPalavras : usa
    Indexador ..> Indice : produz
    Indexador ..> Documento : cria
    Buscador --> "1" Indice : consulta
    PersistenciaIndice ..> Indice : grava / lê
}

package "br.furb.buscador.ui" #F4EEFB {

    class ConsoleUI {
        - {static} ARQUIVO_INDICE : File
        - persistencia : PersistenciaIndice
        - indice : Indice
        + executar()
        - opcaoIndexar()
        - opcaoBuscar()
        - opcaoEstatisticas()
        - carregarIndiceSeExistir()
    }

    class SwingUI {
        - {static} ARQUIVO_INDICE : File
        - persistencia : PersistenciaIndice
        - indice : Indice
        + SwingUI()
        - indexar()
        - buscar()
        - carregarIndiceSeExistir()
    }

    class Main {
        + {static} main(args : String[])
    }

    Main ..> ConsoleUI
    Main ..> SwingUI
    ConsoleUI --> "0..1" Indice
    ConsoleUI --> "1" PersistenciaIndice
    ConsoleUI ..> Indexador
    ConsoleUI ..> Buscador
    ConsoleUI ..> ExtratorPalavras
    SwingUI --> "0..1" Indice
    SwingUI --> "1" PersistenciaIndice
    SwingUI ..> Indexador
}

@enduml
